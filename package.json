{
  "name": "sentinel",
  "version": "0.5.0",
  "description": "A local-first desktop system monitor built with Electron, React, and TypeScript",
  "main": "./out/main/index.js",
  "desktopName": "sentinel.desktop",
  "author": "Drippyz1",
  "license": "MIT",
  "homepage": "https://github.com/Drippyz1/sentinel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drippyz1/sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/Drippyz1/sentinel/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "verify:version": "node scripts/release/verify-version.cjs",
    "verify:diff": "git diff --check",
    "test": "tsc -p tsconfig.test.json && node --test \"out/tests/tests/*.test.js\" \"tests/*.test.cjs\"",
    "verify": "npm run lint && npm test && npm run build && npm run verify:version && npm run verify:diff",
    "smoke:desktop": "electron scripts/smoke-desktop.cjs",
    "benchmark:desktop": "electron scripts/benchmark-desktop.cjs",
    "verify:mac": "node scripts/release/verify-mac-app.cjs",
    "verify:mac:release": "node scripts/release/verify-mac-app.cjs --strict-release",
    "release:check-env": "node scripts/release/check-release-env.cjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir --config electron-builder.dev.yml --publish never",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --config electron-builder.dev.yml --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never",
    "dist": "npm run dist:mac",
    "dist:mac": "npm run dist:mac:release",
    "dist:mac:dev": "npm run build:mac && npm run verify:mac",
    "dist:mac:release": "npm run release:check-env -- mac && npm run build && electron-builder --mac --config electron-builder.release.yml --publish never && npm run verify:mac:release",
    "dist:win": "npm run release:check-env -- win && npm run build && electron-builder --win --config electron-builder.release.yml --publish never",
    "dist:linux": "npm run release:check-env -- linux && npm run build && electron-builder --linux --config electron-builder.release.yml --publish never"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.2.0",
    "systeminformation": "^5.33.26"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/osx-sign": "1.3.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "minimatch@^9.0.0": "11.0.9",
    "minimatch@^10.0.0": "11.0.9"
  }
}
